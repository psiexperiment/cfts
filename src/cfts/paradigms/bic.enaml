'''
Binaural interaction component (BIC) of the ABR, with tone bursts or clicks.

Each ear has its own Starship and output. For every frequency and level (tone
bursts) or level (clicks), the stimulus is presented to the left ear alone,
the right ear alone and both ears at each interaural time difference (ITD;
see `bic_util`). Positive means the right ear leads, as in Laumen et al.
2016:

* `BICManifest` (`abr_bic`) uses tone bursts: the lagging ear's whole burst
  (envelope and carrier) is delayed by the ITD.
* `BICClickManifest` (`abr_bic_click`) uses clicks, the stimulus of the
  rodent BIC studies. Each click plays in a window of fixed length, the
  lagging ear's delayed within it by the ITD.

ITDs are rounded to whole output samples, so that both ears' queues stay in
step. Epochs start at the leading ear's onset, so each monaural ABR is
delayed as its ear was before summing (as Laumen et al. 2016, Ferber et al.
2016 and Benichoux et al. 2018 do; they split the delay as ±ITD/2 per ear,
which differs only in the time origin; see `bic_util.bic_traces`). The
default range, ±1000 µs in 250 µs steps, is Laumen et al.'s.

Run `binaural_crosstalk` first to check that sound from one ear's Starship
does not reach the other ear.

The ears' queues are filled identically, so every trial starts in both ears
on the same sample; the silent ear of a monaural trial plays at -inf dB SPL.
Epochs are extracted from the EEG once per trial, using the left ear's queue.

The BIC is the binaural ABR minus the sum of the monaural ABRs. The plot
overlays, for each frequency and level, the binaural ABR at each ITD on
the sum of the monaural ABRs, and below it the BIC at each ITD.

Defaults follow rodent BIC studies, which use clicks with ITDs: 5 ms tone
pips with 0.5 ms rise (Benson et al. 2024, doi:10.1016/j.heares.2024.109166),
about 30 ± 10 ms between stimuli and at least 500 sweeps per condition
(Laumen et al. 2016, doi:10.1016/j.heares.2016.04.009; Chawla et al. 2022,
doi:10.3389/fnint.2021.803483), a 12 ms epoch, and binaural and monaural
stimuli interleaved. Ferber et al. 2016 (doi:10.1097/AUD.0000000000000315)
and Benichoux et al. 2018 (doi:10.1523/JNEUROSCI.1211-18.2018) use ITDs up
to ±2 ms.
'''
import logging
log = logging.getLogger(__name__)

from collections import Counter
from contextlib import ExitStack
from functools import partial

from atom.api import Enum, List
from enaml.application import deferred_call
from enaml.core.api import d_, Include
from enaml.qt.QtCore import Qt
from enaml.stdlib.message_box import question
from enaml.widgets.api import Action, ToolBar
from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command
import numpy as np
import pyqtgraph as pg

from psi.context.api import (BoolParameter, ContextGroup, ContextRow,
                             EnumParameter, Expression, OrderedContextMeta,
                             Parameter)
from psi.controller.api import (ChannelOutOfRange, ControllerManifest,
                                Detrend, ExperimentAction, ExperimentEvent,
                                ExtractEpochs, QueuedEpochOutput,
                                RejectEpochs, Synchronized)
from psi.core.enaml.api import make_color
from psi.data.api import (EpochTimeContainer, GroupedEpochAveragePlot,
                          ViewBox)
from psi.data.sinks.api import BinaryStore, GroupedEpochCounter, TextStore
from psi.token.primitives import Click, Cos2Envelope, Repeat, Tone

from .abr_io import delays
from .bic_util import (bic_conditions, bic_traces, CLICK, click_window,
                       CONDITION, ear_delays, ear_iti, FREQUENCY, ITD, LEFT,
                       LEVEL, make_queue, plot_key, queue_stimuli, RIGHT,
                       RIGHT_KEY, TONE)
from .cfts_mixins import CFTSSelector


EXPERIMENT = __name__.rsplit('.', 1)[-1]

#: ColorBrewer Dark2, one per ITD.
ITD_COLORS = ['#1b9e77', '#d95f02', '#7570b3', '#e7298a', '#66a61e',
              '#e6ab02', '#a6761d', '#666666']


def ear_expressions(stim):
    '''
    Each ear's stimulus takes its settings from the shared BIC settings.
    `configure_bic` overrides the level, delay, phase (tones), polarity and
    window (clicks) per condition.
    '''
    expressions = []
    for ear in (LEFT, RIGHT):
        if stim is TONE:
            expressions.extend([
                (f'{ear}_tone_burst_duration', 'bic_burst_duration'),
                (f'{ear}_tone_burst_rise_time', 'bic_burst_rise_time'),
                (f'{ear}_tone_burst_start_time', '0'),
                (f'{ear}_tone_frequency', FREQUENCY),
                (f'{ear}_tone_level', LEVEL),
                (f'{ear}_tone_phase', '0'),
                (f'{ear}_tone_polarity', '1'),
            ])
        else:
            expressions.extend([
                (f'{ear}_click_train_n', '1'),
                (f'{ear}_click_train_skip_n', '0'),
                # The window just fits the click; `configure_bic` widens it
                # to fit the largest ITD.
                (f'{ear}_click_train_rate', '1 / bic_click_duration'),
                (f'{ear}_click_train_delay', '0'),
                (f'{ear}_click_duration', 'bic_click_duration'),
                (f'{ear}_click_level', LEVEL),
                (f'{ear}_click_polarity', '1'),
            ])
    return [Expression(parameter=p, expression=e) for p, e in expressions]


def make_iti(rate, rate_jitter_ms, duration, max_delay=0):
    '''
    Interval from the end of one tone burst of `duration` to the start of
    the next. A delayed burst (ITD) takes its delay off this (see
    `ear_iti`), so it must leave room for `max_delay`. Call once per ear:
    with jitter, each ear gets its own generator with the same seed, so both
    draw the same intervals.
    '''
    if rate_jitter_ms > 0:
        min_iti = 1/rate - duration - (rate_jitter_ms * 1e-3)
        max_iti = 1/rate - duration + (rate_jitter_ms * 1e-3)
        if min_iti - max_delay <= 0:
            raise ValueError(f'Repetition rate is too fast. Minimum ITI is {(min_iti - max_delay)*1e3:.0f} msec.')
        rng = np.random.default_rng(seed=987654321)
        return delays(rng, min_iti, max_iti)
    iti = 1/rate - duration
    if iti - max_delay <= 0:
        raise ValueError(f'Repetition rate is too fast. ITI is {(iti - max_delay)*1e3:.0f} msec.')
    return iti


def configure_bic(key_map, stim, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')
    data = event.workbench.get_plugin('psi.data')
    left = controller.get_output(LEFT)
    right = controller.get_output(RIGHT)
    # The ears stay in step only if both queues are read in the same
    # callback (so both have queued the same trials when one is counted)
    # and at the same rate.
    if left.engine is not right.engine:
        raise ValueError('Both ears must be on the same engine')
    if left.fs != right.fs:
        raise ValueError('Both ears must play at the same sampling rate')
    fs = left.fs

    ordering = context.get_value('ordering')
    alternate_polarity = context.get_value('alternate_polarity')
    averages = context.get_value('averages')
    if alternate_polarity and (averages % 2):
        averages += 1
    rate = context.get_value('rate')
    rate_jitter_ms = context.get_value('rate_jitter_ms')

    settings = list(context.iter_settings('default', 1))
    conditions = bic_conditions(settings, stim, fs)
    stimuli, size = queue_stimuli(conditions, ordering, alternate_polarity,
                                  averages, stim)
    left.queue = make_queue(ordering, size)
    right.queue = make_queue(ordering, size)
    values = list(dict.fromkeys(c[ITD] for c in conditions
                                if c[CONDITION] == 'binaural'))
    max_delay = max(max(ear_delays(v, fs)) for v in values)

    if stim is TONE:
        duration = context.get_value('bic_burst_duration')
        window = {}
    else:
        # Each click plays in a window that fits it at the largest delay, so
        # both ears' trials take the same time whatever the ITD.
        duration = click_window(fs, context.get_value('bic_click_duration'),
                                max_delay)
        window = {f'{o}_click_train_rate': 1 / duration for o in (LEFT, RIGHT)}
        # The delay is within the window.
        max_delay = 0
    base_iti = {
        LEFT: make_iti(rate, rate_jitter_ms, duration, max_delay),
        RIGHT: make_iti(rate, rate_jitter_ms, duration, max_delay),
    }

    key_map.clear()
    max_sf = {LEFT: 0, RIGHT: 0}
    for setting, n in stimuli:
        setting = {**setting, **window}
        keys = {}
        # The right ear's key goes in the left ear's metadata (the epochs
        # come from the left ear's queue) so both can be decremented.
        for output in (right, left):
            delay = setting[stim.ear_name(output.name, 'delay')] \
                if stim.delay_lengthens else 0
            iti = ear_iti(base_iti[output.name], delay, fs)
            try:
                keys[output.name], factory = output.add_setting(setting, n,
                                                                iti)
            except ChannelOutOfRange as e:
                raise ValueError(
                    f'{stim.describe(setting)} is {e.db:.1f} dB more than '
                    f'the {output.label.lower()} output can play') from e
            max_sf[output.name] = max(max_sf[output.name],
                                      factory.max_amplitude())
            setting = {**setting, RIGHT_KEY: keys[RIGHT]}
        if FREQUENCY in stim.groups:
            key_map.setdefault(setting[FREQUENCY], []) \
                .append((keys[LEFT], keys[RIGHT]))

    for output in (left, right):
        sf = max_sf[output.name] * 1.01
        output.channel.expected_range = (-sf, sf)

    counter = data.find_sink('valid_erp_counter')
    counter.requested_group_n = averages

    for name in ('bic_overlay_plot', 'bic_plot'):
        deferred_call(setattr, data.find_plot(name), 'values', values)


def decrement_keys(event):
    '''
    Count each valid epoch against its stimulus in both ears' queues.
    '''
    controller = event.workbench.get_plugin('psi.controller')
    left = controller.get_output(LEFT)
    right = controller.get_output(RIGHT)
    counts = Counter((e.metadata['key'], e.metadata[RIGHT_KEY])
                     for e in event.parameters['data'])
    engines = sorted({left.engine, right.engine}, key=lambda e: e.name)
    with ExitStack() as stack:
        for engine in engines:
            stack.enter_context(engine.lock)
        for (left_key, right_key), n in counts.items():
            for output, key in ((left, left_key), (right, right_key)):
                try:
                    output.queue.decrement_key(key, n)
                except KeyError:
                    # Trials already queued when the stimulus completed.
                    pass


def next_frequency(key_map, event):
    controller = event.workbench.get_plugin('psi.controller')
    left = controller.get_output(LEFT)
    ts = controller.get_ts()
    key = left.queue.get_closest_key(ts - 0.5)
    frequency = left.queue.get_info(key)['metadata'][FREQUENCY]
    log.debug('Frequency at %0.2f sec is %.0f Hz', ts, frequency)
    deferred_call(skip_keys, event, frequency, key_map[frequency])


def skip_keys(event, frequency, keys):
    ui = event.workbench.get_plugin('enaml.workbench.ui')
    m = f'Skip remaining levels for {frequency} Hz?'
    button = question(ui.window, 'Skip frequency', m)
    if button.text != 'Yes':
        return

    controller = event.workbench.get_plugin('psi.controller')
    left = controller.get_output(LEFT)
    right = controller.get_output(RIGHT)
    engines = sorted({left.engine, right.engine}, key=lambda e: e.name)
    with ExitStack() as stack:
        for engine in engines:
            stack.enter_context(engine.lock)
        for left_key, right_key in keys:
            for output, key in ((left, left_key), (right, right_key)):
                try:
                    output.queue.remove_key(key)
                except ValueError:
                    log.debug('Key %r already removed', key)


class BICPlot(GroupedEpochAveragePlot):
    '''
    Averages for the selected frequency and level. In `overlay` mode, the
    binaural ABR at each ITD on the sum of the monaural ABRs (with each
    monaural ABR in grey); in `bic` mode, the BIC at each ITD.

    The sum differs with the ITD (each monaural ABR is delayed as its ear
    was), so each binaural ABR gets its own sum, dashed in its colour.
    '''
    mode = d_(Enum('overlay', 'bic'))

    #: ITDs presented, in order. Set when the experiment is configured.
    values = d_(List())

    def _observe_values(self, event):
        binaural = [('binaural', v) for v in self.values]
        if self.mode == 'bic':
            self.plot_keys = binaural
        else:
            sums = [('sum', v) for v in self.values]
            self.plot_keys = [('left',), ('right',)] + sums + binaural

    def group_key(self, md):
        tab_key = tuple(md[g] for g in self.tab_grouping)
        return tab_key, plot_key(md)

    def fmt_value(self, value):
        return f'{value:g} µs'

    def fmt_plot_label(self, key, sep=', '):
        if key[0] == 'sum':
            return f'Left + right, {self.fmt_value(key[1])}'
        if key[0] != 'binaural':
            return {'left': 'Left', 'right': 'Right'}[key[0]]
        prefix = 'Binaural' if self.mode == 'overlay' else 'BIC'
        return f'{prefix} {self.fmt_value(key[1])}'

    def _color(self, value):
        i = self.values.index(value) % len(ITD_COLORS)
        return make_color(ITD_COLORS[i])

    def _pen(self, key):
        if key == ('left',):
            return pg.mkPen(make_color('gray'), style=Qt.DashLine)
        if key == ('right',):
            return pg.mkPen(make_color('gray'), style=Qt.DotLine)
        if key[0] == 'sum':
            return pg.mkPen(self._color(key[1]), width=1, style=Qt.DashLine)
        return pg.mkPen(self._color(key[1]), width=2)

    def _make_new_plot(self, key):
        super()._make_new_plot(key)
        self.plots[key].setPen(self._pen(key))

    def update(self, event=None, tab_changed=False):
        if self._x is None:
            return
        keys = self._groups.keys_for_tab(self.selected_tab)
        if not tab_changed \
                and not any(self._groups.needs_update(k) for k in keys):
            return
        means = {}
        for k in keys:
            mean = self._groups.get_mean(k)
            self._groups.mark_updated(k)
            if mean is not None:
                means[k[1]] = self._render_mean(mean)
        fs = 1 / (self._x[1] - self._x[0])
        sums, bic = bic_traces(means, fs)
        if self.mode == 'overlay':
            traces = dict(means)
            traces.update({('sum', v): y for v, y in sums.items()
                           if v is not None})
        else:
            traces = {('binaural', v): y for v, y in bic.items()}

        todo = []
        for pk in self.plot_keys:
            plot = self.get_plot(pk)
            y = traces.get(pk)
            if y is None or np.isnan(y).all():
                todo.append((plot.setData, ([], [])))
            else:
                n = min(len(self._x), len(y))
                todo.append((plot.setData, (self._x[:n], y[:n])))

        def update():
            for setter, args in todo:
                setter(*args)

        deferred_call(update)


enamldef BICBaseManifest(ControllerManifest): manifest:
    '''
    What the tone and click paradigms share. Each adds its token (named
    `token_name`), the context items of its stimulus and the expressions
    tying each ear's stimulus to them (`ear_expressions`).
    '''
    attr key_map = {}
    attr erp_span = 12e-3

    #: Stimulus (`bic_util.TONE` or `bic_util.CLICK`) and its token.
    attr stim = TONE
    attr token_name = 'tone_burst'

    Extension:
        id = EXPERIMENT + '.selectors'
        point = 'psi.context.selectors'

        CFTSSelector:
            label = 'BIC stimuli'
            can_manage = list(manifest.stim.groups) + [ITD]
            user_managed = False

    Extension:
        id = EXPERIMENT + '.context'
        point = 'psi.context.items'

        OrderedContextMeta: epoch_groups:
            name = 'settings'

        ContextGroup:
            name = 'acquisition'
            label = 'Acquisition'

        ContextGroup:
            name = 'hardware_settings'
            label = 'Hardware'

        ContextGroup:
            name = 'bic'
            label = 'BIC'

            Parameter:
                name = LEVEL
                label = 'Level (dB SPL)'
                default = 80
                scope = 'trial'

            Parameter:
                name = ITD
                label = 'ITD (µs, positive = right leads)'
                default = 0
                scope = 'trial'

        EnumParameter:
            name = 'ordering'
            label = 'Stimulus ordering'
            choices = {
                'conventional': '"sequential"',
                'interleaved plateau': '"interleaved_plateau"',
                'interleaved ramp': '"interleaved_ramp"',
                'interleaved random': '"interleaved_random"',
            }
            scope = 'experiment'
            group_name = 'acquisition'

        ContextRow:
            name = 'averaging'
            group_name = 'acquisition'
            fmt = ['Average', averages, 'pips per condition at', rate,
                   '/s ±', rate_jitter, 'ms and alt. pol.?', alt_pol]

            Parameter: averages:
                name = 'averages'
                label = 'Averages'
                default = 1000
                scope = 'experiment'

            Parameter: rate:
                name = 'rate'
                label = 'Reps. per sec.'
                default = 33
                scope = 'experiment'

            Parameter: rate_jitter:
                name = 'rate_jitter_ms'
                default = 10
                scope = 'experiment'

            BoolParameter: alt_pol:
                name = 'alternate_polarity'
                label = 'Alternate polarity?'
                default = True
                scope = 'experiment'

        ContextRow:
            name = 'artifact_reject'
            group_name = 'acquisition'
            fmt = ['Epochs', detrend_mode, 'detrend. Reject if',
                   reject_mode, '>', reject_threshold]

            EnumParameter: detrend_mode:
                name = 'detrend_mode'
                label = 'Detrend mode'
                choices = {
                    'Do not': 'None',
                    'Constant': '"constant"',
                    'Linear': '"linear"',
                }
                default = 'None'
                scope = 'experiment'

            EnumParameter: reject_mode:
                name = 'reject_mode'
                label = 'Reject mode'
                compact_label = 'Rej. mode'
                choices = {
                    'absolute value': '"absolute value"',
                    'amplitude (max-min)': '"amplitude"',
                }
                default = 'absolute value'
                scope = 'experiment'

            Parameter: reject_threshold:
                name = 'reject_threshold'
                label = 'Reject threshold'
                compact_label = 'Th'
                default = 2.5
                scope = 'experiment'

    Extension:
        id = EXPERIMENT + '.io'
        point = 'psi.controller.io'

        Synchronized:
            name = 'bic_stim'

            QueuedEpochOutput: left_output:
                name = LEFT
                label = 'Left'
                target_name = 'left_output'
                configurable = False
                token = workbench.get_plugin('psi.token') \
                    .get_token(manifest.token_name)
                queue ::
                    # Epochs come from the left ear's queue; the right ear's
                    # plays in step with it.
                    extract.subscribe_to_queue(self.queue)
                complete ::
                    controller = workbench.get_plugin('psi.controller')
                    deferred_call(controller.invoke_actions, 'bic_end')

            QueuedEpochOutput:
                name = RIGHT
                label = 'Right'
                target_name = 'right_output'
                configurable = False
                token = workbench.get_plugin('psi.token') \
                    .get_token(manifest.token_name)

        ExtractEpochs: extract:
            name = 'erp'
            source_name = 'eeg_filtered'
            epoch_size << manifest.erp_span
            Detrend:
                name = 'erp_detrend'
                mode = C.detrend_mode
                RejectEpochs:
                    name = 'valid_erp'
                    threshold = C.lookup('reject_threshold', True)
                    mode = C.reject_mode

    Extension:
        id = EXPERIMENT + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = EXPERIMENT + '.configure'
            handler = partial(configure_bic, manifest.key_map, manifest.stim)

        Command:
            id = EXPERIMENT + '.decrement_keys'
            handler = decrement_keys

        Command:
            id = EXPERIMENT + '.next_frequency'
            handler = partial(next_frequency, manifest.key_map)

    Extension:
        id = EXPERIMENT + '.actions'
        point = 'psi.controller.actions'

        ExperimentEvent:
            name = 'bic_end'

        ExperimentAction:
            event = 'experiment_initialize'
            command = 'psi.context.initialize'
            kwargs = {'selector': 'default', 'cycles': 1}

        ExperimentAction:
            event = 'experiment_prepare'
            command = EXPERIMENT + '.configure'
            weight = 11

        ExperimentAction:
            event = 'engines_configured'
            command = 'bic_stim.start'
            kwargs = {'delay': 1}

        ExperimentAction:
            event = 'valid_erp_acquired'
            command = EXPERIMENT + '.decrement_keys'

        ExperimentAction:
            event = 'bic_end'
            command = 'psi.controller.stop'

    Extension:
        id = EXPERIMENT + '.sinks'
        point = 'psi.data.sinks'

        BinaryStore:
            name = 'erp_eeg'
            continuous_inputs = ['eeg']

        TextStore:
            epoch_inputs = ['erp']

        GroupedEpochCounter:
            name = 'valid_erp_counter'
            label = 'Valid ERPs acquired'
            source_name = 'valid_erp'
            output_name = LEFT
            # One group per stimulus, whichever items are roved.
            extra_groups = list(manifest.stim.groups) + [CONDITION, ITD]

    Extension:
        id = EXPERIMENT + '.plots'
        point = 'psi.data.plots'

        EpochTimeContainer: time_container:
            name = 'bic_container'
            label = 'BIC'
            span << manifest.erp_span
            allow_auto_select << C.ordering == 'sequential'
            fmt_button_cb << C.get_selector() \
                .get_formatter(list(manifest.stim.groups))

            ViewBox:
                name = 'bic_overlay_viewbox'
                y_label = 'Binaural vs. monaural'
                y_min = -5
                y_max = 5
                y_mode = 'mouse'
                save_limits = True

                BICPlot: overlay_plot:
                    name = 'bic_overlay_plot'
                    mode = 'overlay'
                    source_name = 'valid_erp'
                    n_update = 8
                    autogenerate_keys = 'tab'
                    tab_grouping = list(manifest.stim.groups)
                    tab_keys >> time_container.buttons
                    selected_tab := time_container.current_button
                    auto_select := time_container.auto_select

            ViewBox:
                name = 'bic_viewbox'
                y_label = 'BIC'
                y_min = -5
                y_max = 5
                y_mode = 'mouse'
                save_limits = True

                BICPlot:
                    name = 'bic_plot'
                    mode = 'bic'
                    source_name = 'valid_erp'
                    n_update = 8
                    autogenerate_keys = 'tab'
                    tab_grouping = list(manifest.stim.groups)
                    selected_tab := time_container.current_button


enamldef BICManifest(BICBaseManifest): manifest:
    '''
    Tone bursts.
    '''
    Extension:
        id = EXPERIMENT + '.tone.tokens'
        point = 'psi.token.tokens'

        Cos2Envelope:
            name = 'tone_burst'
            label = 'tone burst'
            Tone:
                pass

    Extension:
        id = EXPERIMENT + '.tone.context'
        point = 'psi.context.items'

        Parameter:
            name = FREQUENCY
            label = 'Frequency (Hz)'
            group_name = 'bic'
            default = 8000
            scope = 'trial'

        ContextRow:
            name = 'bic_burst'
            group_name = 'bic'
            fmt = ['Tone bursts', duration, 's with', rise_time, 's rise']

            Parameter: duration:
                name = 'bic_burst_duration'
                label = 'Burst duration (s)'
                default = 5e-3
                scope = 'experiment'

            Parameter: rise_time:
                name = 'bic_burst_rise_time'
                label = 'Burst rise time (s)'
                default = 0.5e-3
                scope = 'experiment'

        Include:
            objects = ear_expressions(TONE)

    Extension:
        id = EXPERIMENT + '.tone.toolbar'
        point = 'psi.experiment.toolbar'

        ToolBar:
            Action:
                text = 'Next freq.'
                enabled << workbench.get_plugin('psi.controller').experiment_state == 'running' \
                    and C.ordering == 'sequential'
                triggered ::
                    core = workbench.get_plugin('enaml.workbench.core')
                    core.invoke_command(EXPERIMENT + '.next_frequency')


enamldef BICClickManifest(BICBaseManifest): manifest:
    '''
    Clicks.
    '''
    stim = CLICK
    token_name = 'click_train'

    Extension:
        id = EXPERIMENT + '.click.tokens'
        point = 'psi.token.tokens'

        # One click, delayed within its window.
        Repeat:
            name = 'click_train'
            label = 'click'

            Click:
                name = 'click'
                label = 'click'

    Extension:
        id = EXPERIMENT + '.click.context'
        point = 'psi.context.items'

        Parameter:
            name = 'bic_click_duration'
            label = 'Click duration (s)'
            group_name = 'bic'
            default = 100e-6
            scope = 'experiment'

        Include:
            objects = ear_expressions(CLICK)
