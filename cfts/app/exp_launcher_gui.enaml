    ProcessManager,
)


class MonitorChannelSettings(Atom):
    '''
    Per-row, per-channel monitor-input configuration: whether to plot the
    channel live (time domain and/or PSD) and/or save it alongside the
    experiment's own recording. "Per-row" (not per-paradigm) means two rows
    running the same paradigm (e.g. two `abr_io` rows) can record different
    channels -- see `Experiment.monitor_input_config`. Which calibration
    applies to the channel is NOT part of this -- that's global, configured
    once via File > Settings (see `Settings.monitor_input_sensors`), not per
    row.
    '''
    plot_time = Bool(False)
    plot_fft = Bool(False)
    save = Bool(False)

    def is_active(self):
        return self.plot_time or self.plot_fft or self.save


def _channels_to_state(channels):
    '''Convert {channel: MonitorChannelSettings} to a JSON-safe dict, only
    keeping channels with something actually enabled.'''
    return {
        channel: {
            'plot_time': c.plot_time,
            'plot_fft': c.plot_fft,
            'save': c.save,
        }
        for channel, c in channels.items() if c.is_active()
    }


def _channels_from_state(state):
    '''Inverse of `_channels_to_state()`.'''
    return {
        channel: MonitorChannelSettings(
            plot_time=c.get('plot_time', False),
            plot_fft=c.get('plot_fft', False),
            save=c.get('save', False),
        )
        for channel, c in state.items()
    }


# NOTE: the per-row monitor_input_config member/__init__/monitor_input_
# config_for_channels()/__getstate__() below are deliberately duplicated
# between Experiment and FrozenExperiment rather than factored into a
# shared mixin -- Atom's C-level __getstate__ silently corrupts member
# values when a Member is declared on a plain (non-Atom) mixin class ahead
# of the Atom base in the MRO, so each must declare it directly as a
# straight single-inheritance subclass of its own psiapp base.


class Experiment(_Experiment):

    #: Per-row (not per-paradigm) monitor-input configuration: which input
    #: channels to plot/save while running THIS row, independent of every
    #: other row -- including another row for the same paradigm (e.g. two
    #: `abr_io` rows can record different channels). Persisted as part of
    #: this row's own __getstate__(), not globally in Settings, so it
    #: travels with the row through save_config()/load_config() and
    #: through freeze(). Populated lazily -- see
    #: monitor_input_config_for_channels().
    monitor_input_config = Dict()

    def __init__(self, *args, monitor_input_config=None, **kwargs):
        super().__init__(*args, **kwargs)
        self.monitor_input_config = _channels_from_state(monitor_input_config or {})

    def monitor_input_config_for_channels(self):
        '''
        Return the (mutable, live) per-channel monitor-input configuration
        for this row, creating default entries for any input channel
        present on this system but not yet configured.
        '''
        channels = self.monitor_input_config
        for name in list_inputs().values():
            channels.setdefault(name, MonitorChannelSettings())
        return channels

    def __getstate__(self):
        state = super().__getstate__()
        state['monitor_input_config'] = _channels_to_state(self.monitor_input_config)
        return state

    def freeze(self, mode, ear='selected'):
        '''
        Return experiment in which mode and ear are fixed. Used in running
        sequences.

        Parameters
        ----------
        mode : str
            One of the modes the paradigm can be run under (e.g., 'run',
            'ipsi', 'contra').
        ear : {'selected', 'left', 'right'}
            Ear to run experiment on. When set to a specific ear, the
            configuration must have two starships (one for each ear). When set
            to 'selected', the ear currently selected in the GUI will be used.

        This is used for sequences where we may need to specify run mode (i.e.,
        ipsi vs. contra) as well as ear (e.g. in assays where we have a
        separate starship for each ear such as the MEMR).
        '''
        if mode is None:
            mode = self.modes[0]
        return FrozenExperiment(
            paradigm=self.paradigm,
            preference=self.preference,
            plugins=self.plugins,
            mode_notes=self.mode_notes,
            monitor_input_config=_channels_to_state(self.monitor_input_config),
            mode=mode,
            ear=ear,
        )


class FrozenExperiment(_FrozenExperiment):
    '''
    Subclass of FrozenExperiment in which we have frozen the ear and mode (used
    for sequences).
    '''
    #: If either, then ear will be drawn from what is selected.
    ear = Enum('selected', 'left', 'right')

    #: See Experiment.monitor_input_config.
    monitor_input_config = Dict()

    def __init__(self, *args, monitor_input_config=None, **kwargs):
        super().__init__(*args, **kwargs)
        self.monitor_input_config = _channels_from_state(monitor_input_config or {})

    def monitor_input_config_for_channels(self):
        channels = self.monitor_input_config
        for name in list_inputs().values():
            channels.setdefault(name, MonitorChannelSettings())
        return channels

    def __getstate__(self):
        state = super().__getstate__()
        state['monitor_input_config'] = _channels_to_state(self.monitor_input_config)
        return state


class Settings(Atom):

    logging_level = Enum('trace', 'debug', 'info', 'warning', 'error')('info')
    animal = Str()
    ear = Enum('left', 'right')
    experimenter = Str()
    note = Str()
    standard_notes = List(Str())
    standard_note = Str()

    monitor_sequence = List(Experiment)
    experiment_sequence = List(Experiment)

    #: Bumped on every change to any sensor's calibration/gain -- Enaml's
    #: `<<` binding tracer only sees direct `obj.attr` reads executed in
    #: the traced expression's own bytecode, so it can't see through
    #: equipment_calibration()'s dict lookups and method calls (get_calibration(),
    #: is_configured()). The main window's read-only calibration/gain Labels
    #: read this member directly (a plain LOAD_ATTR, which IS traced) purely
    #: to force re-evaluation when a sensor changes; its value is otherwise
    #: meaningless. Same pattern as InputRecordingSettings._readiness_tick
    #: in cftscal.
    _calibration_tick = Int()

    def _bump_calibration_tick(self, change):
        self._calibration_tick += 1

    def _watch_sensor(self, sensor):
        for member in ('name', 'device_type', 'gain', 'sensitivity'):
            sensor.observe(member, self._bump_calibration_tick)
        return sensor

    #: Global (not per-paradigm) calibration/gain for each monitorable input
    #: channel -- configured once via File > Settings. Maps channel name ->
    #: a MultiTypeSensorReference. Populated lazily -- see
    #: monitor_input_sensor_for(). Persisted to a shared hardware config
    #: file, not the experiment config -- see save_hardware_config()/
    #: load_hardware_config().
    monitor_input_sensors = Dict()

    def monitor_input_sensor_for(self, channel_name):
        if channel_name not in self.monitor_input_sensors:
            self.monitor_input_sensors[channel_name] = self._watch_sensor(
                MultiTypeSensorReference(device_type='Unity')
            )
        return self.monitor_input_sensors[channel_name]

    #: Global calibration for each configurable output (hw_ao) channel --
    #: configured once via File > Settings > Outputs. Maps output channel
    #: name -> an OutputCalibrationReference. Populated lazily -- see
    #: output_sensor_for(). Does NOT cover a starship's own primary/
    #: secondary channels -- those aren't independently configured (see
    #: equipment_calibration()). Persisted to a shared hardware config
    #: file, not the experiment config -- see save_hardware_config()/
    #: load_hardware_config().
    output_sensors = Dict()

    def output_sensor_for(self, channel_name):
        if channel_name not in self.output_sensors:
            self.output_sensors[channel_name] = self._watch_sensor(
                OutputCalibrationReference(device_type='Speaker')
            )
        return self.output_sensors[channel_name]

    def configurable_outputs(self):
        '''
        Output channels to show under Settings > Outputs: every hw_ao
        channel EXCEPT a starship's own primary/secondary pair -- a
        starship's calibration is one and the same as its microphone's
        (see equipment_calibration()), and its output channels have no
        independent calibration of their own (left at Unity for now).
        '''
        starship_channels = {
            f'{k}{suffix}' for k in self.starship_config
            for suffix in ('_primary', '_secondary')
        }
        return {
            label: name for label, name in list_outputs().items()
            if name not in starship_channels
        }

    def equipment_calibration(self, key, expected_type):
        '''
        Resolve the calibration to use for an output device (a starship or
        speaker connection, keyed the same as starship_config/speaker_config).

        A starship's calibration (and gain) is one and the same as its own
        probe microphone's -- its two output channels (primary/secondary)
        aren't independently configured -- so 'Starship' resolves via the
        matching Input Channels entry (`<key>_microphone`). A speaker has
        no built-in microphone, so 'Speaker' resolves directly via the
        Outputs list instead (`<key>` is already the speaker's own output
        channel name).

        Returns the configured sensor, or None if unconfigured or the
        wrong type is selected there.
        '''
        if expected_type == 'Starship':
            sensor = self.monitor_input_sensors.get(f'{key}_microphone')
        else:
            sensor = self.output_sensors.get(key)
        if sensor is None:
            return None
        if sensor.device_type != expected_type or not sensor.is_configured():
            return None
        return sensor

    #: Dictionary of sequence names to lists of FrozenExperiment
    sequences = Dict()

    #: Currently selected sequences
    current_sequence_name = Str()

    #: Currently selected sequence (this has to be broken out from sequences to
    #: enable proper change notifications, I think).
    current_sequence = List(FrozenExperiment)

    #: Configuration for available starships
    starship_config = Dict()

    #: Configuration for available speakers
    speaker_config = Dict()

    #: String indicating starship configuration. Either mono (indicating that
    #: we have a single starship that is used for either ear) or stereo (one
    #: starship per ear).
    audio_mode = Property()

    #: Create a process manager that will handle communication with experiment
    #: subprocesses.
    process_manager = Typed(ProcessManager, ())

    def move_sequence_item_to(self, i, j):
        pass

    def _observe_current_sequence_name(self, event):
        # This is needed to sync up changes where we select the sequence from the
        # GUI
        if self.current_sequence_name != '':
            self.current_sequence = self.sequences.setdefault(self.current_sequence_name, [])
        else:
            self.current_sequence = []

    def _observe_current_sequence(self, event):
        # This is needed to sync back changes from the experiment display in the GUI
        if self.current_sequence_name != '':
            self.sequences[self.current_sequence_name] = self.current_sequence

    def _get_audio_mode(self):
        if self.find_output('right', True) == self.find_output('left', True):
            return 'mono'
        else:
            return 'stereo'

    record_body_temperature = Bool(True)
    swap_outputs = Bool(False)

    #: How should speakers be configured?
    #: * in-ear - Perform in-ear calibration before starting experiment. Specify
    #:   stimulus levels in dB SPL.
    #: * attenuation - Specify stimulus levels in dB attenuation.
    #: * debug - Set the calibration such that it assumes 1 Vrms = 130 dB SPL.
    #:   Allows for testing of existing experiments without having to update
    #:   the stimulus levels from dB SPL to dB attenuation.
    calibration_mode = Enum('in-ear', 'attenuation', 'debug')
    input_amp_config = Dict()

    def _default_standard_notes(self):
        return ['']

    def find_output(self, ear, monaural=True):
        '''
        Return output configured for specified ear

        Parameters
        ----------
        ear : {'left', 'right', 'freefield'}
            Ear to locate output for
        monaural : bool
            If True, will load the output marked for either ear if it exists
            and it can't find an output specifically designated for the
            requested ear.
        '''
        output_to_use = set()
        for k, v in self.starship_config.items():
            if v['ear'] == ear:
                output_to_use.add(k)
            elif v['ear'] == 'either' and monaural:
                output_to_use.add(k)
        for k, v in self.speaker_config.items():
            if v['ear'] == ear:
                output_to_use.add(k)
            elif v['ear'] == 'either' and monaural:
                output_to_use.add(k)

        if len(output_to_use) != 1:
            log.error(output_to_use)
            raise ValueError(f'Outputs incorrectly configured. Found {len(output_to_use)} for {ear}.')

        return next(iter(output_to_use))

    def build_experiment(self, experiment, mode, ear, save=True,
                         open_minimized=False):
        '''
        Build the experiment arguments and environment for launching in subprocess

        Parameters
        ----------
        experiment : instance of `Experiment`
            Experiment to run.
        mode : str
            Mode experiment will be run in. This mainly affects the calibration
            configuration to ensure the appropriate calibrations are loaded
            into environment variables to be passed to the subprocess.
        ear : str
            Ear being tested. This mainly affects the calibration configuration
            as well as the filename.
        save : bool
            If True, generates a filename to save the data to.
        open_minimized : bool
            If True, sends a command indicating the application should open the
            window minimized to the task tray.
        '''
        amp_input_name = self.input_amp_config['input_name']
        env = {
            'WEBSOCKETS_URI': self.process_manager.ws_server.connected_uri,
            'CFTS_INPUT_AMPLIFIER': amp_input_name,
            f'CFTS_INPUT_AMPLIFIER_{amp_input_name.upper()}_GAIN': str(self.input_amp_config['gain']),
            f'CFTS_INPUT_AMPLIFIER_{amp_input_name.upper()}_FREQ_LB': str(self.input_amp_config['freq_lb']),
            f'CFTS_INPUT_AMPLIFIER_{amp_input_name.upper()}_FREQ_UB': str(self.input_amp_config['freq_ub']),
        }
        for k in self.starship_config:
            sensor = self.equipment_calibration(k, 'Starship')
            if sensor is None:
                raise ValueError(
                    f'No calibration configured for {k} -- select one for '
                    f'its microphone channel in File > Settings'
                )
            env[f'CFTS_STARSHIP_{k.upper()}'] = sensor.get_calibration().to_string()
            env[f'CFTS_STARSHIP_{k.upper()}_GAIN'] = str(sensor.gain)
        for k in self.speaker_config:
            sensor = self.equipment_calibration(k, 'Speaker')
            if sensor is None:
                raise ValueError(
                    f'No calibration configured for {k} -- select one under '
                    f'Outputs in File > Settings'
                )
            # No _GAIN env var here -- unlike inputs/starships, an output's
            # `initialize_output()` handler (cftscal/paradigms/objects.enaml)
            # never reads one; a speaker has no preamp gain to record.
            env[f'CFTS_SPEAKER_{k.upper()}'] = sensor.get_calibration().to_string()

        if mode.lower() == 'either':
            env['CFTS_TEST_STARSHIP'] = self.find_output(ear, True)
        elif mode.lower() == 'ipsi':
            env['CFTS_TEST_STARSHIP'] = self.find_output(ear, True)
            env['CFTS_NONTEST_STARSHIP'] = env['CFTS_TEST_STARSHIP']
        elif mode.lower() == 'contra':
            env['CFTS_TEST_STARSHIP'] = self.find_output(ear, True)
            try:
                nontest_ear = 'right' if ear == 'left' else 'left'
                env['CFTS_NONTEST_STARSHIP'] = self.find_output(nontest_ear, False)
            except ValueError:
                pass
        elif mode.lower() == 'binaural':
            env['CFTS_LEFT_STARSHIP'] = self.find_output('left', False)
            env['CFTS_RIGHT_STARSHIP'] = self.find_output('right', False)
        elif mode.lower() == 'freefield':
            env['CFTS_SPEAKER'] = self.find_output('freefield', False)

        mode_note = experiment.mode_notes.get(mode, '')
        filename = f'{{date_time}} {self.experimenter} {self.animal} {ear} {self.note} {self.standard_note} {mode_note} {experiment.paradigm.name}'
        filename = ' '.join(filename.split())
        args = ['psi', experiment.paradigm.full_name]
        if save:
            args.append(str(DATA_ROOT / filename))
        args.extend([
            '--preferences', experiment.preference,
            '--debug-level-console', self.logging_level.upper(),
        ])
        for plugin in experiment.plugins:
            args.extend(['--plugin', plugin])

        # Recording/plotting the calibration microphone or output monitor
        # is now just a matter of enabling save/plot on their own Input
        # Channels row (they're ordinary hw_ai channels) -- see below.
        # This is per-row (experiment.monitor_input_config), not
        # per-paradigm -- see Experiment.monitor_input_config.
        active_channels = {
            n: c for n, c in experiment.monitor_input_config.items() if c.is_active()
        }
        if active_channels:
            unconfigured = [
                n for n in active_channels
                if not self.monitor_input_sensor_for(n).is_configured()
            ]
            if unconfigured:
                raise ValueError(
                    f'Select a calibration (File > Settings) for monitored '
                    f'channel(s): {", ".join(unconfigured)}'
                )
            env['CFTS_MONITOR_INPUTS'] = ','.join(active_channels)
            for name, config in active_channels.items():
                sensor = self.monitor_input_sensor_for(name)
                prefix = f'CFTS_MONITOR_INPUT_{name.upper()}'
                env[prefix] = sensor.get_calibration().to_string()
                env[f'{prefix}_GAIN'] = str(sensor.gain)
                env[f'{prefix}_PLOT_TIME'] = str(int(config.plot_time))
                env[f'{prefix}_PLOT_FFT'] = str(int(config.plot_fft))
                env[f'{prefix}_SAVE'] = str(int(config.save))
            args.extend(['--plugin', 'monitor_inputs_view'])

        if self.swap_outputs:
            args.extend(['--plugin', 'swap_outputs'])

        if self.record_body_temperature:
            for p in experiment.paradigm.plugins:
                if p.id  == 'temperature':
                    args.extend(['--plugin', 'temperature'])
                    break
            else:
                log.warning('No temperature plugin available for %s',
                            experiment.paradigm.name)

        if self.calibration_mode == 'in-ear':
            for p in experiment.paradigm.plugins:
                if p.id.endswith('_inear_calibration'):
                    args.extend(['--plugin', p.id])
                    break
            else:
                log.warning('No in-ear plugin available for %s', experiment.paradigm.name)
        elif self.calibration_mode == 'debug':
            args.extend(['--plugin', 'debug_calibration'])

        if open_minimized:
            args.extend(['-c', 'psi.minimize_window'])

        return args, env

    def run_experiment(self, experiment, mode, save=True, autostart=False):
        frozen_experiment = experiment.freeze(mode, self.ear)
        self.prepare_sequence([frozen_experiment], save=save)
        self.process_manager.autostart = autostart
        self.process_manager.open_next_subprocess()

    def prepare_sequence(self, sequence, save=True):
        for i, experiment in enumerate(sequence):
            ear = self.ear if experiment.ear == 'selected' else experiment.ear
            cmd, env = self.build_experiment(experiment,
                                             experiment.mode,
                                             ear,
                                             save=save,
                                             )
            self.process_manager.add_command(cmd, env)

    def save_config(self, filename):
        info = {
            'ear': self.ear,
            'logging_level': self.logging_level,
            'starship_config': self.starship_config,
            'speaker_config': self.speaker_config,
            'input_amp_config': {
                'input_name': self.input_amp_config['input_name'],
                'gain': self.input_amp_config['gain'],
                'freq_lb': self.input_amp_config['freq_lb'],
                'freq_ub': self.input_amp_config['freq_ub'],
            },
            'standard_notes': self.standard_notes,
            'current_sequence_name': self.current_sequence_name,

            'record_body_temperature': self.record_body_temperature,
            'swap_outputs': self.swap_outputs,
        }

        def get_sequence_state(sequence):
            result = []
            for experiment in sequence:
                state = experiment.__getstate__()
                state.pop('preferences')
                result.append(state)
            return result

        info['experiment_sequence'] = get_sequence_state(self.experiment_sequence)
        info['monitor_sequence'] = get_sequence_state(self.monitor_sequence)
        info['sequences'] = {n: get_sequence_state(s) for n, s in self.sequences.items()}

        for key in ('starship_config', 'speaker_config'):
            # Calibration/gain aren't stored here -- see equipment_calibration().
            info[key] = {k: {'ear': v['ear']} for k, v in getattr(self, key).items()}

        filename = Path(filename)
        filename.write_text(json.dumps(info, indent=2))

    def save_hardware_config(self, filename):
        '''
        Save the calibration/gain configured for each monitorable input
        channel and each configurable output channel (File > Settings).
        This is rig hardware, not experiment configuration -- it belongs in
        its own file, shared across every experiment config for the same
        rig, and loaded alongside one (see load_hardware_config()).
        '''
        info = {
            'monitor_input_sensors': {
                channel: sensor.get_persistence()
                for channel, sensor in self.monitor_input_sensors.items()
            },
            'output_sensors': {
                channel: sensor.get_persistence()
                for channel, sensor in self.output_sensors.items()
            },
        }
        filename = Path(filename)
        filename.write_text(json.dumps(info, indent=2))

    def load_hardware_config(self, filename=None):
        '''
        Load the calibration/gain for each monitorable input channel and
        each configurable output channel from a shared hardware config
        file (see save_hardware_config()). Any channel not present in the
        file falls back to its lazily-created Unity default (see
        monitor_input_sensor_for()/output_sensor_for()).
        '''
        if filename is not None:
            filename = Path(filename)
            info = json.loads(filename.read_text())
        else:
            info = {}

        # NOTE: _watch_sensor() must run BEFORE set_persistence() -- it only
        # wires up the observers that bump _calibration_tick; calling it
        # after would miss the very change events set_persistence() triggers,
        # and the main window's read-only calibration/gain Labels (which
        # depend on that tick -- see its own docstring) would then silently
        # stay stale after a hardware config load.
        monitor_input_sensors = {}
        for channel, c in info.pop('monitor_input_sensors', {}).items():
            sensor = self._watch_sensor(MultiTypeSensorReference(device_type='Unity'))
            sensor.set_persistence(c)
            monitor_input_sensors[channel] = sensor
        self.monitor_input_sensors = monitor_input_sensors

        output_sensors = {}
        for channel, c in info.pop('output_sensors', {}).items():
            sensor = self._watch_sensor(OutputCalibrationReference(device_type='Speaker'))
            sensor.set_persistence(c)
            output_sensors[channel] = sensor
        self.output_sensors = output_sensors

        self._bump_calibration_tick(None)

    def load_config(self, filename=None):
        if filename is not None:
            filename = Path(filename)
            info = json.loads(filename.read_text())
        else:
            info = {}

        info.pop('experimenter', None)
        # Legacy key from the old flat-list monitor_inputs model, superseded
        # by the per-row monitor_input_config (see Experiment.monitor_input_config).
        info.pop('monitor_inputs', None)

        # Load and resurrect the experiment sequences 
        self.experiment_sequence = load_experiments(info.pop('experiment_sequence', []), Experiment)
        self.monitor_sequence = load_experiments(info.pop('monitor_sequence', []), Experiment)
        self.sequences = {n: load_experiments(s, FrozenExperiment) for n, s in info.pop('sequences', {}).items()}
        self.current_sequence_name = info.pop('current_sequence_name', '')

        # Update the starship config list to reflect current starship
        # connections. Label is always overwritten even if it is stored in the
        # config since the user may be modifying the label in the hardware
        # confiruration file.
        # Calibration/gain are NOT stored here -- they're derived from the
        # matching input channel's sensor (see Settings.equipment_calibration()),
        # so only 'ear' (and the always-recomputed 'label') need to persist.
        starship_config = info.pop('starship_config', {})
        starships = list(list_starship_connections().values())
        starship_map = {name: label for label, name in list_starship_connections().items()}
        for starship in starships:
            if starship not in starship_config:
                starship_config[starship] = {'ear': 'not used', 'label': starship_map[starship]}
        # Make sure all configs are present
        for starship in list(starship_config.keys()):
            if starship not in starships:
                starship_config.pop(starship)
            else:
                s = starship_config[starship]
                s.pop('calibration', None)
                s.pop('gain', None)
                s.setdefault('ear', 'not used')
                s['label'] = starship_map[starship]
        self.starship_config = starship_config

        # Update the speaker config list to reflect current speaker connections
        speaker_config = info.pop('speaker_config', {})
        speakers = list(list_speaker_connections().values())
        speaker_map = {name: label for label, name in list_speaker_connections().items()}
        for speaker in speakers:
            if speaker not in speaker_config:
                speaker_config[speaker] = {'ear': 'not used', 'label': speaker_map[speaker]}
        # Make sure all configs are present
        for speaker in list(speaker_config.keys()):
            if speaker not in speakers:
                speaker_config.pop(speaker)
            else:
                s = speaker_config[speaker]
                s.pop('calibration', None)
                s.pop('gain', None)
                s.setdefault('ear', 'not used')
                s['label'] = speaker_map[speaker]
        self.speaker_config = speaker_config

        # Legacy keys from the old dedicated cal-mic/output-monitor
        # checkboxes, superseded by enabling save/plot on their own Input
        # Channels row.
        info.pop('cal_mic_config', None)
        info.pop('record_cal_mic', None)
        info.pop('record_output_monitor', None)
        info.pop('show_output_monitor', None)

        input_amp_config = info.pop('input_amp_config', {})
        if 'input_name' not in input_amp_config:
            input_amp_config['input_name'] = None
        if 'gain' not in input_amp_config:
            input_amp_config['gain'] = 50e3
        if 'freq_lb' not in input_amp_config:
            input_amp_config['freq_lb'] = 10
        if 'freq_ub' not in input_amp_config:
            input_amp_config['freq_ub'] = 10e3
        self.input_amp_config = input_amp_config

        # Legacy top-level key from when monitor-input configuration was
        # per-paradigm (shared by every row using that paradigm) rather than
        # per-row -- it now lives on each row itself (see
        # Experiment.monitor_input_config), embedded in experiment_sequence/
        # monitor_sequence/sequences and resolved by load_experiments()
        # above.
        info.pop('monitor_input_config', None)

        # monitor_input_sensors/output_sensors (calibration/gain for each
        # input and output channel) now live in their own hardware config
        # file, shared across experiment configs for the same rig -- see
        # save_hardware_config()/load_hardware_config(), called separately
        # (e.g. `cfts <experiment_config.json> <hardware_config.json>` or
        # File > Load hardware config). Discard a legacy experiment config
        # that still embeds them rather than silently reviving stale data.
        if 'monitor_input_sensors' in info or 'output_sensors' in info:
            log.warning(
                'Ignoring monitor_input_sensors/output_sensors embedded in '
                'experiment config %r -- move them to a hardware config '
                'file and load it via File > Load hardware config.',
                filename,
            )
        info.pop('monitor_input_sensors', None)
        info.pop('output_sensors', None)

        # Setting all remaining items
        for k, v in info.items():
            try:
                setattr(self, k, v)
            except Exception as e:
                log.exception(e)
                log.error('Unable to set attribute %s with value %r', k, v)
                raise

        # Belt-and-suspenders: force the main window's read-only
        # calibration/gain Labels to re-evaluate after a full config load,
        # regardless of whether every individual sensor observer fired
        # above (e.g. a loaded value that happens to match a fresh
        # sensor's default wouldn't trigger one).
        self._bump_calibration_tick(None)


enamldef ExperimentSequence(_ExperimentSequence):

    attr exp_class = Experiment


enamldef ExperimentInfo(GroupBox):
    title = 'Experiment Info'

    constraints = [
        vbox(
            hbox(experimenter_label, experimenter_field),
            hbox(animal_label, animal_field, hbox(l_button, r_button, spacing=0)),
            hbox(note_label, note_field),
            hbox(standard_note_label, standard_note),
            hbox(spacer(0), pb_raw),
        ),
        align('right', experimenter_label, animal_label, note_label, standard_note_label),
        align('left', experimenter_label, animal_label, note_label, standard_note_label),
        align('v_center', experimenter_label, experimenter_field),
        align('v_center', animal_label, animal_field, l_button, r_button),
        align('v_center', note_label, note_field),
        align('v_center', standard_note_label, standard_note),
        l_button.width == 30,
        r_button.width == 30,
        pb_raw.width == 90,
    ]

    ButtonGroup: ear_group:
        pass

    Label: experimenter_label:
        text = 'Experimenter'

    Field: experimenter_field:
        text := settings.experimenter

    Label: animal_label:
        text = 'Animal'

    Field: animal_field:
        text := settings.animal

    Label: note_label:
        text = 'Note'

    Field: note_field:
        text := settings.note

    Label: standard_note_label:
        text = 'Standard notes'

    AddRemoveCombo: standard_note:
        selected := settings.standard_note
        items << settings.standard_notes
        items ::
            settings.standard_notes = items[:]

    PushButton: l_button:
        text = 'L'
        checkable = True
        group = ear_group
        checked << settings.ear == 'left'
        checked ::
            settings.ear = 'left'

    PushButton: r_button:
        text = 'R'
        checkable = True
        group = ear_group
        checked << settings.ear == 'right'
        checked ::
            settings.ear = 'right'

    PushButton: pb_raw:
        text = '📂 Raw'
        clicked ::
            os.startfile(DATA_ROOT)


enamldef MonitorInputsView(Container): view:
    '''
    Per-row inline channel picker, embedded in the row's ⚙ popup (see
    `PluginPopup`/`ExperimentSequence.build_channels_view` in psiapp): pick
    which input channels to plot live (time domain and/or PSD) and/or save
    alongside the recording while running `experiment`. This is specific to
    this one row -- another row running the same paradigm can be configured
    to record different channels (see `Experiment.monitor_input_config`). Which
    calibration applies to a channel is NOT configured here -- that's
    global, shared across every row (see File > Update Hardware Config /
    `SettingsDialog`), since it doesn't make sense for the same physical
    channel to have a different calibration depending on which row happens
    to be monitoring it.
    '''
    attr experiment
    attr channel_config << experiment.monitor_input_config_for_channels()

    padding = 0

    Form:
        padding = 0
        Looper:
            iterable << sorted(list_inputs().items())
            Label:
                text = loop_item[0]
            HGroup:
                padding = 0
                CheckBox:
                    text = 'Time'
                    checked := channel_config[loop_item[1]].plot_time
                CheckBox:
                    text = 'PSD'
                    checked := channel_config[loop_item[1]].plot_fft
                CheckBox:
                    text = 'Save'
                    checked := channel_config[loop_item[1]].save


enamldef SettingsDialog(Dialog): dialog:
    '''
    Global (not per-paradigm/per-experiment) hardware settings: which
    calibration (and, for inputs, gain) to use for each monitorable input
    channel and each configurable output channel. This is the single
    source of truth for that configuration -- the main window's Equipment
    Configuration panel only displays it (read-only); edit it here instead.

    A starship does NOT get its own picker under Outputs -- its
    calibration (and gain) IS the calibration of its own built-in
    microphone, so it's configured by picking the 'Starship' type on that
    microphone's own row under Input Channels (named
    `<connection>_microphone`, e.g. `starship_A_microphone`); its two
    output channels (primary/secondary) are left at Unity. A speaker has
    no built-in microphone, so it's configured directly under Outputs
    instead. See `Settings.equipment_calibration()`.
    '''
    attr settings

    title = 'Settings'
    initial_size = (600, 650)

    Container:
        layout_constraints => ():
            input_widgets = input_group.visible_widgets()
            output_widgets = output_group.visible_widgets()
            labels = input_widgets[::2] + output_widgets[::2]

            type_combos = []
            for w in (input_widgets[1::2] + output_widgets[1::2]):
                type_combos.append(w.visible_widgets()[0])

            return [
                vbox(input_group, output_group, action_buttons, spacing=10),
                align('width', *labels),
                align('width', *type_combos),
            ]

        GroupBox: input_group:
            title = 'Input channels'
            flat = True
            share_layout = True

            layout_constraints => ():
                widgets = [c for c in self.children if not isinstance(c, Looper)]
                rows = zip(widgets[0::2], widgets[1::2])
                return [vbox(*[hbox(l, v) for l, v in rows], spacing=5)]

            Looper:
                iterable << sorted(list_inputs().items())
                Label:
                    text = loop_item[0]
                SensorView:
                    sensor << settings.monitor_input_sensor_for(loop_item[1])
                    mode = 'static'
                    show_label = False
                    fill_row = True

        GroupBox: output_group:
            title = 'Output channels'
            flat = True
            share_layout = True

            layout_constraints => ():
                widgets = [c for c in self.children if not isinstance(c, Looper)]
                rows = zip(widgets[0::2], widgets[1::2])
                return [vbox(*[hbox(l, v) for l, v in rows], spacing=5)]

            Looper:
                iterable << sorted(settings.configurable_outputs().items())
                Label:
                    text = loop_item[0]
                SensorView:
                    sensor << settings.output_sensor_for(loop_item[1])
                    mode = 'static'
                    show_label = False
                    show_gain = False
                    fill_row = True

        HGroup: action_buttons:
            leading_spacer = spacer(0)
            PushButton:
                text = 'Close'
                clicked ::
                    dialog.accept()


enamldef Main(MainWindow): main:

    title = 'Cochlear Function Test Suite'

    attr settings = Settings()
    attr edit_mode = False

    func build_monitor_channels_view(experiment):
        return [MonitorInputsView(experiment=experiment)]

    MenuBar:
        Menu:
            title = '&File'
            Action:
                text = 'Load config\tCtrl+O'
                triggered ::
                    path = CFTS_ROOT / 'cfts-launcher'
                    path.mkdir(exist_ok=True, parents=True)
                    filename = FileDialogEx.get_open_file_name(
                        current_path=str(path),
                        name_filters=['Experiment Settings (*.json)'],
                    )
                    if filename:
                        settings.load_config(filename)
            Action:
                text = 'Save config\tCtrl+O'
                triggered ::
                    path = CFTS_ROOT / 'cfts-launcher'
                    path.mkdir(exist_ok=True, parents=True)
                    filename = FileDialogEx.get_save_file_name(
                        current_path=str(path),
                        name_filters=['Experiment Settings (*.json)'],
                    )
                    if filename:
                        settings.save_config(filename)
            Action:
                separator = True
            Action:
                text = 'Load hardware config'
                triggered ::
                    path = CFTS_ROOT / 'cfts-launcher'
                    path.mkdir(exist_ok=True, parents=True)
                    filename = FileDialogEx.get_open_file_name(
                        current_path=str(path),
                        name_filters=['Hardware Settings (*.json)'],
                    )
                    if filename:
                        settings.load_hardware_config(filename)
            Action:
                text = 'Save hardware config'
                triggered ::
                    path = CFTS_ROOT / 'cfts-launcher'
                    path.mkdir(exist_ok=True, parents=True)
                    filename = FileDialogEx.get_save_file_name(
                        current_path=str(path),
                        name_filters=['Hardware Settings (*.json)'],
                    )
                    if filename:
                        settings.save_hardware_config(filename)
            Action:
                text = 'Update Hardware Config'
                triggered ::
                    SettingsDialog(parent=main, settings=settings).exec_()
            Action:
                separator = True
            Action:
                text = 'Edit experiment config'
                checkable = True
                checked := main.edit_mode

        Menu:
            title = '&Options'
            Menu:
                title = 'Logging Level'
                ActionGroup:
                    Looper:
                        iterable = settings.get_member('logging_level').items
                        Action:
                            checkable = True
                            text = loop_item
                            checked ::
                                settings.logging_level = loop_item
                            checked << settings.logging_level == loop_item
            Action:
                separator = True
            Action:
                text = 'Swap primary/secondary outputs'
                checkable = True
                checked := settings.swap_outputs
            Action:
                text = '&Monitor body temperature'
                checkable = True
                checked := settings.record_body_temperature
            Action:
                separator = True
            Menu:
                title = 'Calibration method'
                ActionGroup:
                    Looper:
                        iterable = settings.get_member('calibration_mode').items
                        Action:
                            text = loop_item.capitalize()
                            checkable = True
                            checked << loop_item == settings.calibration_mode
                            checked ::
                                settings.calibration_mode = loop_item

    Container:

        constraints = [
            vbox(
                starship_info,
                experiment_info,
                experiment_nb,
                experiment_stats,
            ),
        ]

        GroupBox: starship_info:
            title = 'Equipment Configuration'
            flat = True
            share_layout = True

            layout_constraints => ():
                header = children[:3]
                widgets = [c for c in children[3:] \
                           if not isinstance(c, Looper) \
                           and not isinstance(c, Container)]
                extra_widgets = [c for c in children[3:] if isinstance(c, Container)]
                extra_labels = [w.children[0] for w in extra_widgets]
                zipped = list(zip(
                    widgets[0::4],   # labels
                    widgets[1::4],   # ear select
                    widgets[2::4],   # starship select
                    widgets[3::4],   # gain select
                ))
                constraints = [
                    vbox(
                        hbox(*header),
                        *[hbox(*r) for r in zipped],
                        *extra_widgets,
                    ),
                ]
                constraints.extend([align('v_center', *r) for r in zipped])
                constraints.extend([
                    align('left', header[0], *widgets[1::4]),
                    align('left', header[1], *widgets[2::4]),
                    align('left', header[2], *widgets[3::4]),
                    align('left', eeg_label, *widgets[0::4]),
                    align('left', eeg_input_name, header[0]),
                ])
                return constraints

            Label:
                text = 'Ear'
            Label:
                text = 'Calibration'
            Label:
                text = 'Gain'

            Looper:
                iterable << settings.starship_config.keys()
                Label:
                    text = f'Starship {settings.starship_config[loop_item]["label"]}'
                ObjectCombo:
                    items = ['either', 'left', 'right', 'not used']
                    selected << settings.starship_config[loop_item]['ear']
                    selected ::
                        settings.starship_config[loop_item]['ear'] = selected
                #: Read-only -- derived from the matching input channel's
                #: calibration; configure it via File > Settings (SettingsDialog),
                #: not here. See Settings.equipment_calibration().
                Label:
                    text << (
                        lambda s, _tick: s.get_calibration().name if s is not None else 'Not configured'
                    )(settings.equipment_calibration(loop_item, 'Starship'), settings._calibration_tick)
                Label:
                    text << (
                        lambda s, _tick: f'{s.gain} dB' if s is not None else ''
                    )(settings.equipment_calibration(loop_item, 'Starship'), settings._calibration_tick)

            Looper:
                iterable << settings.speaker_config.keys()
                Label:
                    text = f'{settings.speaker_config[loop_item]["label"]}'
                ObjectCombo:
                    items = ['either', 'left', 'right', 'freefield', 'not used']
                    selected << settings.speaker_config[loop_item]['ear']
                    selected ::
                        settings.speaker_config[loop_item]['ear'] = selected
                #: Read-only -- configured via File > Settings > Outputs
                #: (SettingsDialog), not here. See Settings.equipment_calibration().
                Label:
                    text << (
                        lambda s, _tick: s.get_calibration().name if s is not None else 'Not configured'
                    )(settings.equipment_calibration(loop_item, 'Speaker'), settings._calibration_tick)
                #: Speakers have no gain/preamp concept -- see
                #: Settings.equipment_calibration()'s docstring.
                Label:
                    text = ''

            Container:
                padding = 0
                share_layout = True

                constraints = [
                    hbox(*self.visible_widgets()),
                    align('v_center', *self.visible_widgets()),
                ]

                Label: eeg_label:
                    text ='EEG amplifier'

                ObjectCombo: eeg_input_name:
                    attr choices = list_input_amplifier_connections()
                    attr choices_lookup << {v: k for k, v in choices.items()}
                    items << list(choices_lookup)
                    selected << settings.input_amp_config['input_name']
                    selected ::
                        settings.input_amp_config['input_name'] = selected
                    to_string = choices_lookup.get

                ObjectCombo: eeg_gain:
                    items = [10e3, 20e3, 50e3, 100e3]
                    selected << settings.input_amp_config['gain']
                    selected ::
                        settings.input_amp_config['gain'] = selected
                    to_string = lambda x: f'{x:.0f} ✕'

                ObjectCombo: eeg_freq_lb:
                    items = [1, 3, 10, 30, 100, 300]
                    selected << settings.input_amp_config['freq_lb']
                    selected ::
                        settings.input_amp_config['freq_lb'] = selected
                    to_string = lambda x: f'{x} Hz'

                Label: eeg_to_label:
                    text = 'to'

                ObjectCombo: eeg_freq_ub:
                    items = [3000, 10000]
                    selected << settings.input_amp_config['freq_ub']
                    selected ::
                        settings.input_amp_config['freq_ub'] = selected
                    to_string = lambda x: f'{x} Hz'

        ExperimentInfo: experiment_info:
            pass

        Notebook: experiment_nb:
            tab_style = 'document'
            Page:
                title = 'Checks (not saved)'
                closable = False
                Container:
                    CheckBox: check_autostart:
                        text = 'Autostart?'
                        checked = False
                    ExperimentSequence:
                        padding = 0
                        sequence := main.settings.monitor_sequence
                        save = False
                        edit_mode << main.edit_mode
                        settings << main.settings
                        autostart << check_autostart.checked
                        build_channels_view = build_monitor_channels_view
            Page:
                title = 'Experiments'
                closable = False
                Container:
                    CheckBox: exp_autostart:
                        text = 'Autostart?'
                        checked = False
                    ExperimentSequence: experiment_box:
                        padding = 0
                        start_enabled << (bool(main.settings.animal) and bool(main.settings.experimenter))
                        sequence := main.settings.experiment_sequence
                        edit_mode << main.edit_mode
                        settings << main.settings
                        autostart << exp_autostart.checked
                        build_channels_view = build_monitor_channels_view

            Page:
                title = 'Sequences'
                closable = False
                Container:
                    padding = 0
                    HGroup:
                        align_widths = False
                        Label:
                            text = 'Name'
                        AddRemoveCombo:
                            items << list(settings.sequences.keys())
                            selected := settings.current_sequence_name
                            remove_clicked ::
                                del settings.sequences[settings.current_sequence_name]
                                settings.current_sequence_name = ''
                            editable << main.edit_mode
                        PushButton:
                            enabled << (bool(main.settings.animal) and bool(main.settings.experimenter) and
                                        main.settings.process_manager.current_subprocess is None)
                            text = 'Run'
                            clicked ::
                                sequence = settings.current_sequence[:]
                                main.settings.prepare_sequence(sequence)
                                main.settings.process_manager.autostart = True
                                main.settings.process_manager.open_next_subprocess()

                    Conditional:
                        condition << bool(main.settings.current_sequence_name)
                        ExperimentSequence:
                            mode = 'sequence'
                            sequence := main.settings.current_sequence
                            edit_mode << main.edit_mode
                            settings << main.settings
                            build_channels_view = build_monitor_channels_view

        GroupBox: experiment_stats:
            title = 'Experiment Info'
            flat = True
            share_layout = True

            Label:
                text << f'Last run took {int(settings.process_manager.duration//60)} min and {int(settings.process_manager.duration % 60)} sec'
